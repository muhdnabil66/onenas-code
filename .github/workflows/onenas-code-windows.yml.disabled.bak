name: ONeNas Code signed Windows pilot

on:
  workflow_dispatch:
    inputs:
      version:
        description: Pilot version label
        required: true
        type: string

permissions:
  contents: read
  id-token: write

jobs:
  package-windows:
    runs-on: windows-latest
    environment: onenas-code-pilot
    steps:
      - uses: actions/checkout@v4

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: 1.3.14

      - uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Verify release signing configuration
        shell: pwsh
        run: |
          $required = @(
            "${{ secrets.AZURE_TRUSTED_SIGNING_ENDPOINT }}",
            "${{ secrets.AZURE_TRUSTED_SIGNING_ACCOUNT_NAME }}",
            "${{ secrets.AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE }}"
          )
          if ($required | Where-Object { -not $_ }) {
            throw "Azure Trusted Signing secrets are required"
          }

      - run: bun install --frozen-lockfile

      - name: Test managed protocol contracts
        working-directory: packages/onenas-protocol
        run: bun test

      - name: Test desktop packaging config
        working-directory: packages/desktop
        run: bun test electron-builder.config.test.ts src/main/atlas-provider-bridge.test.ts

- name: Package signed Windows x64 installer
      working-directory: packages/desktop
      run: bun run package:win --x64 --publish never
      env:
          ONENAS_CHANNEL: prod
          ONENAS_AUTO_UPDATE: "0"
          AZURE_TRUSTED_SIGNING_ENDPOINT: ${{ secrets.AZURE_TRUSTED_SIGNING_ENDPOINT }}
          AZURE_TRUSTED_SIGNING_ACCOUNT_NAME: ${{ secrets.AZURE_TRUSTED_SIGNING_ACCOUNT_NAME }}
          AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE: ${{ secrets.AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE }}

      - uses: actions/upload-artifact@v4
        with:
          name: ONeNas-Code-Windows-${{ inputs.version }}
          path: packages/desktop/dist/ONeNas-Code-Setup-*.exe
          if-no-files-found: error
